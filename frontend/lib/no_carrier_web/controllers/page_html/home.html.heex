<Layouts.app flash={@flash} current_scope={@current_scope}>
  <section id="hero" class="flex flex-col items-center gap-6 pt-4 text-center">
    <img src={~p"/images/nocarrier-lockup-dark.svg"} alt="NO CARRIER" class="w-full max-w-xl" />
    <p class="text-xs uppercase tracking-[0.35em] text-secondary sm:text-sm">
      An always-running, AI-played space conquest game
    </p>
    <p class="max-w-prose leading-relaxed text-base-content/80">
      You don't pilot the flagship. Your admiral does, on the standing orders you leave behind,
      in a universe that keeps moving whether you are connected or not.
    </p>
    <div class="pt-2">
      <%= if @current_scope do %>
        <.link
          navigate={~p"/play"}
          id="enter-game"
          class="btn btn-primary btn-lg uppercase tracking-[0.2em]"
        >
          Enter the game <.icon name="hero-arrow-right" class="size-5" />
        </.link>
      <% else %>
        <a
          href={~p"/auth/github"}
          id="sign-in"
          class="btn btn-primary btn-lg uppercase tracking-[0.2em]"
        >
          <svg viewBox="0 0 16 16" class="size-5" fill="currentColor" aria-hidden="true">
            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z" />
          </svg>
          Sign in with GitHub
        </a>
      <% end %>
    </div>
  </section>

  <section id="briefing" class="grid gap-6 sm:grid-cols-3">
    <.panel title="Doctrine">
      <p class="text-sm leading-relaxed text-base-content/70">
        Write standing orders. Your admiral carries them out tick after tick, with or without you.
      </p>
    </.panel>
    <.panel title="The universe">
      <p class="text-sm leading-relaxed text-base-content/70">
        Numbered sectors, one-way lanes, ports that trade. Created once at the big bang and never regenerated.
      </p>
    </.panel>
    <.panel title="Discovery">
      <p class="text-sm leading-relaxed text-base-content/70">
        Everyone sees the public map. The lanes worth money are the ones you find, then sell or keep.
      </p>
    </.panel>
  </section>

  <.prompt>
    <%= if @current_scope do %>
      CONNECT 2400 · admiral {@current_scope.player.login} standing by
    <% else %>
      NO CARRIER · sign in to reconnect
    <% end %>
  </.prompt>
</Layouts.app>
